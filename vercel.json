{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "data/**",
        "*.html",
        "css/**",
        "js/**",
        "routes/**",
        "models/**",
        "utils/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/lesson", "destination": "/lesson.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/progress", "destination": "/progress.html" },
    { "source": "/question-generator", "destination": "/question-generator.html" },
    { "source": "/quiz", "destination": "/quiz.html" },
    { "source": "/result", "destination": "/result.html" },
    { "source": "/subjects", "destination": "/subjects.html" }
  ]
}
